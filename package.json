{
  "name": "spacefield",
  "version": "0.1.0",
  "license": "MIT",
  "description": "A multi-workspace desktop OS in the browser \u2014 draggable windows, a dock, a launchpad, and 130+ native tools.",
  "author": "Asad Iqbal",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=7168 next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node -e \"try { require.resolve('vitest/package.json'); require('child_process').execSync('npx vitest run', { stdio: 'inherit' }) } catch (e) { console.log('[test] vitest not installed \u2014 install with: pnpm add -D vitest @vitest/coverage-v8'); process.exit(0) }\"",
    "test:e2e": "node -e \"try { require.resolve('@playwright/test/package.json'); require('child_process').execSync('npx playwright test', { stdio: 'inherit' }) } catch (e) { console.log('[test:e2e] @playwright/test not installed \u2014 install with: pnpm add -D @playwright/test && pnpm exec playwright install --with-deps chromium'); process.exit(0) }\"",
    "check:bundle": "node scripts/check-bundle-budget.js",
    "postinstall": "node -e \"try { require('fs').statSync('.git'); require('child_process').execSync('git config core.hooksPath .githooks', { stdio: 'ignore' }) } catch (e) {}\""
  },
