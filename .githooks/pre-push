#!/usr/bin/env bash
# Pre-push hook: run the same build Vercel runs.
# Blocks pushes that would fail deploy.
# Bypass with `git push --no-verify` (only in emergencies).
#
# SE-012 — Migrated from `npm run build` to `pnpm build` so the hook
# matches the package manager actually used by CI + Vercel (pnpm).
# `npm install` would have happily regenerated `package-lock.json`
# alongside the real `pnpm-lock.yaml`, which then caused Vercel to
# rebuild against the wrong dependency tree.

set -e

echo ""
echo "▲ Running pre-push build check (matches Vercel) ..."
echo ""

if ! command -v pnpm >/dev/null 2>&1; then
  echo "✗ pnpm not found — install with: corepack enable && corepack prepare pnpm@latest --activate"
  exit 1
fi

# Run the same build Vercel runs. `--silent` is the npm-only flag; pnpm
# uses `--reporter silent` or just inherits quiet output via `--reporter
# append-only`. Easiest: drop the flag and let the build output stream —
# the human readable tail -40 still trims to the last lines.
if pnpm build 2>&1 | tail -40; then
  echo ""
  echo "✓ Build passed — push allowed"
  echo ""
else
  echo ""
  echo "✗ Build failed — push blocked"
  echo "  Fix the errors above, then try again."
  echo "  To bypass (emergency only): git push --no-verify"
  echo ""
  exit 1
fi
