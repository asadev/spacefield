#!/usr/bin/env bash
# Pre-push hook: run the same build Vercel runs.
# Blocks pushes that would fail deploy.
# Bypass with `git push --no-verify` (only in emergencies).

set -e

echo ""
echo "▲ Running pre-push build check (matches Vercel) ..."
echo ""

if ! command -v npm >/dev/null 2>&1; then
  echo "✗ npm not found — install Node.js"
  exit 1
fi

# Run the same build Vercel runs
if npm run build --silent 2>&1 | tail -40; then
  echo ""
  echo "✓ Build passed — push allowed"
  echo ""
else
  echo ""
  echo "✗ Build failed — push blocked"
  echo "  Fix the errors above, then try again."
  echo "  To bypass (emergency only): git push --no-verify"
  echo ""
  exit 1
fi
