# ---------------------------------------------------------------------------
# Spacefield — environment settings
#
# Copy this file to `.env.local` and fill in the values you need.
#
#   cp .env.example .env.local
#
# ONLY the "Required" block is needed to boot the app. Everything below it is
# optional: leave a key blank and the feature that uses it stays switched off
# rather than crashing. Nothing here has a default that points at someone
# else's account.
# ---------------------------------------------------------------------------

# === Required — the app will not start without these ========================
# Create a free project at https://supabase.com, then copy these from
# Project Settings -> API. Run the SQL in `supabase/migrations/` first.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key      # server only — never expose
SUPABASE_SERVICE_ROLE=                          # alias, some modules read this name

# The public address the app runs at. http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000                  # server-side copy of the above

# === Public share links (optional) =========================================
# The domain your published forms, pages, quotes and files are served from.
# Point your own domain at this same deployment, then name it here.
# Leave it blank and the share surface stays dormant.
NEXT_PUBLIC_SHARE_DOMAIN=

# === Admin access ===========================================================
# Comma-separated emails allowed into /admin. Empty = nobody gets in.
ADMIN_EMAILS=

# === Security secrets — generate your own ===================================
# Any long random string works: `openssl rand -hex 32`
AUTH_FINGERPRINT_SECRET=
MFA_RECOVERY_PEPPER=
UNSUBSCRIBE_TOKEN_SECRET=
CRON_SECRET=
HEALTH_DEEP_TOKEN=
SKILLS_HTTP_HANDLER_SECRET=

# === Email (optional) — password resets, invites, notifications =============
# Resend: https://resend.com  (free tier covers 3,000 emails/month)
RESEND_API_KEY=
EMAIL_FROM_NOREPLY=noreply@example.com
# Postmark is supported as an alternative to Resend.
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM=outbound

# === File storage (optional) — uploads, wallpapers, exports =================
# Cloudflare R2, or any S3-compatible service.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_FILES=
R2_PUBLIC_URL=

# === AI features (optional) — the assistant, summaries, transcription =======
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WHATSAPP_AI_OPENAI_MODEL=gpt-4o-mini
WHATSAPP_AI_ANTHROPIC_MODEL=claude-haiku-4-5
WHATSAPP_AI_TRANSCRIBE_MODEL=whisper-1

# === Payments (optional) — subscriptions and billing ========================
# Paddle: https://paddle.com
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# === WhatsApp inbox (optional) ==============================================
# Either Meta's WhatsApp Cloud API, or a self-hosted Evolution API gateway.
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_BUSINESS_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# === Telegram bot (optional) ================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# === Analytics and error tracking (optional) ================================
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# === Deployment helpers (optional) ==========================================
# Only needed if you use the admin panel's built-in deploy tooling.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# === Development only =======================================================
PLAYWRIGHT_BASE_URL=http://localhost:3000
SPACEFIELD_BUNDLE_BUDGET_KB=
PROPAGATION_WAIT_MS=

# ---------------------------------------------------------------------------
# Set automatically by the platform — you do not add these yourself:
#   NODE_ENV, CI, VERCEL_ENV, VERCEL_URL, VERCEL_REGION,
#   VERCEL_DEPLOYMENT_ID, VERCEL_GIT_COMMIT_SHA,
#   NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA
# ---------------------------------------------------------------------------
